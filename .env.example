# Telegram bot token from @BotFather
BOT_TOKEN=
# Owner Telegram user id(s), comma separated: 123456789,987654321
OWNER=
# Optional: channel/chat id for error logs (bot must be able to post there)
ERRCN=
# Owner display name used in prefixes and prompts
OWNER_NAME=Nikita
# IANA timezone used by the schedule (defaults to server timezone)
TIMEZONE=Europe/Moscow

# SQLite database path
DB_PATH=./database/shadow_pilot.db

# ---------- AI provider (any OpenAI-compatible API) ----------
AI_ENABLED=true

# OpenAI (key required)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Ollama on the same machine (no key needed):
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1:8b
# Ollama on the host while the bot runs in Docker:
# AI_BASE_URL=http://host.docker.internal:11434/v1
# Ollama from docker-compose (`--profile ollama`):
# AI_BASE_URL=http://ollama:11434/v1

# LM Studio:   AI_BASE_URL=http://localhost:1234/v1
# OpenRouter:  AI_BASE_URL=https://openrouter.ai/api/v1   (key required)
# Groq:        AI_BASE_URL=https://api.groq.com/openai/v1 (key required)

# Legacy names still work: OPENAI_API_KEY, OPENAI_BASE_URL, OPENAI_MODEL
